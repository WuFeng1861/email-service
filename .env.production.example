# ── 运行环境 ──────────────────────────────────────────────
NODE_ENV=production
PORT=5777
HOST=127.0.0.1
# 反代层数：Nginx 与服务同机 = 1；若前面还套了一层（老机器 Nginx → 本机 Nginx）= 2
# 设错会导致 IP 黑白名单/限流拿到的不是真实客户端 IP
# TRUST_PROXY=1

# ── 数据库（SQLite）─────────────────────────────────────
DB_FILE=data/email-server.db
DB_SYNCHRONIZE=false

# ── 管理端 ───────────────────────────────────────────────
# 管理员账号密码不在这里配置：前端首次访问「设置管理员」页创建，
# 存 admin_users 表（scrypt 哈希），之后可在管理端自助修改。

# ── IP 过滤（规则和开关在数据库里，由管理端维护）────────────
# 回环豁免：Nginx / pm2 / 健康检查都从 127.0.0.1 来
IP_ALLOW_LOOPBACK=true
# business = 只管业务接口（管理端不受限，防止把自己锁在门外）；all = 全站
IP_FILTER_SCOPE=business
# 紧急开关：设 true 可一次性关掉全部 IP 过滤（改完需重启进程）
IP_FILTER_DISABLED=false
# 访问记录
REQUEST_LOG_ENABLED=true
REQUEST_LOG_RETENTION_DAYS=7
REQUEST_LOG_SKIP_HEALTH=true

CORS_ORIGINS=https://wufeng98.cn

# ── 心跳上报（给 wufeng98.cn 项目面板用；默认开启，写 false 才关）──────
REPORT_ENABLED=true
# 面板鉴权口令：填原来 backup/*/.env 里的 SERVER_PASSWORD（三个项目同一个）
# 留空则不上报该字段，面板会返回 401/403（不影响服务本身运行）
REPORT_PASSWORD=
# 可选：稳定标识。留空则只靠 SERVICE_NAME 认项目，此时不会发送该字段
REPORT_SERVICE_ID=
REPORT_ENDPOINT=https://wufeng98.cn/projectManagerApi/projects
# 面板靠这个字段认项目，改名会新增条目而不是更新原条目
SERVICE_NAME=email-service1115
# 部署时由 deploy.js 按 --host 自动填；手工部署就填服务器公网 IP
SERVER_IP=
# 可选：面板上的描述文字 / 上报间隔（毫秒）
# REPORT_DESCRIPTION=NestJS 邮件发送服务
# REPORT_INTERVAL_MS=60000
